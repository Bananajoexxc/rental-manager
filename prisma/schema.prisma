generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model rental {
  id               String               @id @default(uuid())
  listing_id       String               @unique
  title            String
  status           String
  start_date       DateTime?
  end_date         DateTime?
  renter_info      String?
  listing_url      String
  description      String?
  photos_urls      String[]
  rental_price     Float?
  price_per_day    Float?
  currency         String?              @default("GBP")
  account          String?
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt
  listing_location String?
  parsed_items     Json?
  order_step       String?
  renter_price     Float?
  transcript_hash  String?
  ai_decisions     ai_decision[]
  bookings         booking[]
  extracted_items  extracteditem[]
  follow_up_state  follow_up_state?
  catalog_items    itemcatalog[]
  renter_links     rental_renter_link[]

  @@index([status])
  @@index([listing_id])
  @@index([account])
}

model extracteditem {
  id               String   @id @default(uuid())
  rental_id        String
  item_name        String
  source           String
  confidence_score Float?
  created_at       DateTime @default(now())
  rental           rental   @relation(fields: [rental_id], references: [id], onDelete: Cascade)

  @@index([rental_id])
  @@index([source])
}

model itemcatalog {
  id            String   @id @default(uuid())
  listing_id    String
  item_name     String
  description   String?
  first_seen_at DateTime @default(now())
  rental        rental   @relation(fields: [listing_id], references: [listing_id], onDelete: Cascade)

  @@unique([listing_id, item_name])
  @@index([listing_id])
}

model conversation {
  id         String   @id @default(uuid())
  chat_id    String
  role       String
  content    String
  metadata   Json?
  created_at DateTime @default(now())

  @@index([chat_id])
  @@index([created_at])
  @@index([chat_id, created_at])
}

model ai_decision {
  id                String   @id @default(uuid())
  rental_id         String?
  decision_type     String
  input_summary     String
  output_summary    String
  confidence        Float?
  action_taken      String?
  notified          Boolean  @default(false)
  created_at        DateTime @default(now())
  feedback_analyzed Boolean  @default(false)
  was_sent          Boolean?
  rental            rental?  @relation(fields: [rental_id], references: [id])

  @@index([rental_id])
  @@index([decision_type])
  @@index([created_at])
  @@index([created_at, confidence])
  @@index([was_sent])
  @@index([feedback_analyzed])
}

model rule {
  id         String   @id @default(uuid())
  category   String
  name       String
  content    String
  is_active  Boolean  @default(true)
  priority   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([category])
  @@index([is_active])
}

model memory {
  id           String    @id @default(uuid())
  memory_type  String
  subject      String
  content      String
  importance   Int       @default(5)
  access_count Int       @default(0)
  expires_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([memory_type])
  @@index([importance])
  @@index([subject])
}

model bot_config {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@index([key])
}

model booking {
  id                           String    @id @default(uuid())
  item_name                    String
  quantity                     Int       @default(1)
  start_date                   DateTime
  end_date                     DateTime
  renter_name                  String
  renter_contact               String?
  account                      String
  rental_id                    String?
  pickup_time                  String?
  return_time                  String?
  pickup_reminded              Boolean   @default(false)
  return_reminded              Boolean   @default(false)
  status                       String    @default("confirmed")
  revenue                      Float?
  platform_fee                 Float?
  delivery_fee                 Float?
  net_profit                   Float?
  notes                        String?
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt
  pickup_date                  DateTime?
  return_date                  DateTime?
  pickup_arrival_confirmed     Boolean   @default(false)
  pickup_arrival_followup_sent Boolean   @default(false)
  pickup_arrival_sent_at       DateTime?
  return_arrival_confirmed     Boolean   @default(false)
  return_arrival_followup_sent Boolean   @default(false)
  return_arrival_sent_at       DateTime?
  pickup_method                String?
  return_method                String?
  pickup_pre_reminded          Boolean   @default(false)
  return_pre_reminded          Boolean   @default(false)
  midpoint_checkin_sent        Boolean   @default(false)
  rental                       rental?   @relation(fields: [rental_id], references: [id])

  @@index([item_name])
  @@index([start_date, end_date])
  @@index([renter_name])
  @@index([status])
  @@index([account])
  @@index([item_name, status, start_date, end_date])
  @@index([item_name, status, return_date, end_date])
}

model blacklisted_renter {
  id         String   @id @default(uuid())
  name       String   @unique
  reason     String
  added_by   String   @default("owner")
  created_at DateTime @default(now())
}

model demand_record {
  id               String    @id @default(uuid())
  items            String[]
  bundle_label     String?
  dates_start      DateTime?
  dates_end        DateTime?
  renter_name      String?
  account          String?
  outcome          String    @default("pending")
  rejection_reason String?
  rental_value     Float?
  source           String?
  created_at       DateTime  @default(now())

  @@index([outcome])
  @@index([created_at])
}

model item_spec {
  id         String  @id @default(uuid())
  item_name  String  @unique
  weight_kg  Float?
  length_cm  Float?
  width_cm   Float?
  height_cm  Float?
  size_score Int     @default(2)
  category   String?
  notes      String?

  @@index([item_name])
  @@index([size_score])
}

model market_snapshot {
  id           String   @id @default(uuid())
  competitor   String
  item_name    String
  price_daily  Float?
  review_count Int?
  avg_rating   Float?
  listing_url  String?
  scraped_at   DateTime @default(now())

  @@index([competitor])
  @@index([item_name])
  @@index([scraped_at])
}

model market_report {
  id          String   @id @default(uuid())
  report_type String
  content     String
  insights    Json?
  created_at  DateTime @default(now())

  @@index([report_type])
  @@index([created_at])
}

model error_log {
  id                String   @id @default(uuid())
  error_type        String
  operation         String
  message           String
  stack_trace       String?
  context           Json?
  feedback_analyzed Boolean  @default(false)
  created_at        DateTime @default(now())

  @@index([feedback_analyzed])
  @@index([created_at])
}

model system_diagnostic {
  id         String   @id @default(uuid())
  category   String
  event_type String
  summary    String
  data       Json
  rental_id  String?
  created_at DateTime @default(now())

  @@index([category])
  @@index([event_type])
  @@index([created_at])
  @@index([rental_id])
}

model validation_log {
  id             String   @id @default(uuid())
  ai_decision_id String?
  response_text  String
  violations     String[]
  severity       String
  blocked        Boolean
  created_at     DateTime @default(now())

  @@index([severity])
  @@index([blocked])
  @@index([created_at])
  @@index([ai_decision_id])
}

model response_quality {
  id                  String   @id @default(uuid())
  ai_decision_id      String   @unique
  pricing_accuracy    Float?
  rule_compliance     Float
  conciseness         Float
  tone_match          Float
  overall_quality     Float
  computed_confidence Float
  created_at          DateTime @default(now())

  @@index([overall_quality])
  @@index([created_at])
}

model prompt_component {
  id          String   @id @default(uuid())
  name        String
  version     String
  content     String
  category    String
  active      Boolean  @default(true)
  ab_group    String?
  usage_count Int      @default(0)
  pass_rate   Float?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([name, version])
  @@index([category])
  @@index([active])
  @@index([ab_group])
}

model prompt_version_log {
  id              String   @id @default(uuid())
  component_name  String
  version         String
  ai_decision_id  String
  validation_pass Boolean
  quality_score   Float?
  created_at      DateTime @default(now())

  @@index([component_name])
  @@index([version])
  @@index([created_at])
}

model renter_profile {
  id                          String               @id @default(uuid())
  hygglo_user_id              String?              @unique
  name                        String
  name_variants               String[]
  verification_status         String               @default("unknown")
  verification_attempts       Int                  @default(0)
  verification_guided         Boolean              @default(false)
  verification_failure_guided Boolean              @default(false)
  total_rentals               Int                  @default(0)
  first_seen_at               DateTime             @default(now())
  last_seen_at                DateTime             @default(now())
  items_interested            String[]
  last_inquiry_summary        String?
  previous_agreements         String?
  rental_progress             String?
  rental_issues_note          String?
  requires_manual_approval    Boolean              @default(false)
  total_spend                 Float                @default(0)
  hygglo_bad_reviews          String?
  hygglo_rating               Float?
  hygglo_review_count         Int?
  rating_checked_at           DateTime?
  preferences                 Json?
  loyalty_voucher             loyalty_voucher?
  renter_links                rental_renter_link[]

  @@index([name])
  @@index([hygglo_user_id])
}

model rental_renter_link {
  id                String         @id @default(uuid())
  rental_id         String
  renter_profile_id String
  created_at        DateTime       @default(now())
  rental            rental         @relation(fields: [rental_id], references: [id], onDelete: Cascade)
  renter_profile    renter_profile @relation(fields: [renter_profile_id], references: [id], onDelete: Cascade)

  @@unique([rental_id, renter_profile_id])
  @@index([rental_id])
  @@index([renter_profile_id])
}

model postcode_cache {
  id          String   @id @default(uuid())
  postcode    String   @unique
  latitude    Float
  longitude   Float
  distance_km Float
  zone        String
  cached_at   DateTime @default(now())

  @@index([postcode])
  @@index([cached_at])
}

model upsell_log {
  id                String   @id @default(uuid())
  rental_id         String
  items_suggested   String[]
  items_accepted    String[]
  revenue_before    Float
  revenue_after     Float?
  upsell_priority   String
  use_case_detected String?
  outcome           String   @default("pending")
  created_at        DateTime @default(now())

  @@index([rental_id])
  @@index([outcome])
  @@index([created_at])
}

model revenue_metric {
  id           String    @id @default(uuid())
  rental_id    String?
  metric_type  String
  amount       Float
  account      String?
  metadata     Json?
  period_start DateTime?
  period_end   DateTime?
  created_at   DateTime  @default(now())

  @@index([metric_type])
  @@index([account])
  @@index([created_at])
  @@index([rental_id])
}

model autolearn_proposal {
  id             String    @id @default(uuid())
  cycle_id       String
  analyzer       String
  change_type    String
  target_entity  String
  description    String
  change_payload Json
  shadow_result  Json?
  status         String    @default("pending")
  veto_deadline  DateTime
  vetoed_by      String?
  veto_reason    String?
  applied_at     DateTime?
  rolled_back_at DateTime?
  created_at     DateTime  @default(now())
  failed_shadow  Json?
  parent_id      String?
  rework_count   Int       @default(0)
  rework_reason  String?

  @@index([status])
  @@index([veto_deadline])
  @@index([cycle_id])
  @@index([analyzer])
  @@index([created_at])
}

model autolearn_log {
  id             String   @id @default(uuid())
  proposal_id    String?
  event_type     String
  details        Json?
  quality_before Float?
  quality_after  Float?
  created_at     DateTime @default(now())

  @@index([event_type])
  @@index([proposal_id])
  @@index([created_at])
}

model autolearn_snapshot {
  id            String   @id @default(uuid())
  proposal_id   String
  entity_type   String
  entity_id     String
  snapshot_data Json
  created_at    DateTime @default(now())

  @@index([proposal_id])
  @@index([entity_type])
  @@index([created_at])
}

model follow_up_state {
  id                     String    @id @default(uuid())
  rental_id              String    @unique
  last_renter_message_at DateTime?
  last_bot_message_at    DateTime?
  last_bot_followup_at   DateTime?
  followup_count         Int       @default(0)
  custom_reminder_at     DateTime?
  custom_reminder_reason String?
  paused_until           DateTime?
  auto_accept_eligible   Boolean   @default(false)
  auto_accepted          Boolean   @default(false)
  items_confirmed        Boolean   @default(false)
  availability_verified  Boolean   @default(false)
  discount_eligible      Boolean   @default(false)
  discount_applied       Boolean   @default(false)
  status                 String    @default("active")
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  conversation_stage     String    @default("inquiry")
  stage_changed_at       DateTime?
  last_time_followup_at  DateTime?
  time_followup_count    Int       @default(0)
  time_request_sent      Boolean   @default(false)
  time_request_sent_at   DateTime?
  times_auto_assigned    Boolean   @default(false)
  times_auto_assigned_at DateTime?
  times_status           String    @default("none")
  conversation_summary   String?
  rejected_suggestions   String?
  stage_before_dead      String?
  structured_state       Json?
  rental                 rental    @relation(fields: [rental_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([rental_id])
}

model lost_revenue_record {
  id              String   @id @default(uuid())
  hygglo_order_id String   @unique
  title           String
  renter_info     String?
  account         String
  start_date      DateTime
  end_date        DateTime
  rental_days     Int
  hygglo_price    Float?
  estimated_price Float?
  lost_revenue    Float
  items_requested Json
  stock_blocked   Boolean
  blocked_items   String[]
  synced_at       DateTime @default(now())
  created_at      DateTime @default(now())
  unmatched_items String[]
  active_step     String?
  denial_type     String?

  @@index([account])
  @@index([start_date])
  @@index([stock_blocked])
  @@index([denial_type])
}

model revenue_loss_monthly {
  id             String   @id @default(uuid())
  period_start   DateTime
  period_end     DateTime
  account        String   @default("")
  denied_revenue Float
  denied_count   Int
  denied_items   String[]
  lost_revenue   Float
  lost_count     Int
  lost_items     String[]
  created_at     DateTime @default(now())

  @@unique([period_start, account])
  @@index([period_start])
}

model competitor_profile {
  id             String               @id @default(uuid())
  name           String
  slug           String               @unique
  profile_url    String?
  total_reviews  Int                  @default(0)
  avg_rating     Float?
  total_listings Int                  @default(0)
  last_scraped   DateTime?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  listings       competitor_listing[]
  reviews        competitor_review[]

  @@index([name])
}

model competitor_listing {
  id             String             @id @default(uuid())
  competitor_id  String
  title          String
  item_category  String?
  daily_price    Float?
  owner_earnings Float?
  listing_url    String?
  listing_slug   String?
  is_active      Boolean            @default(true)
  first_seen     DateTime           @default(now())
  last_seen      DateTime           @default(now())
  competitor     competitor_profile @relation(fields: [competitor_id], references: [id], onDelete: Cascade)

  @@unique([competitor_id, title])
  @@index([competitor_id])
  @@index([item_category])
  @@index([is_active])
}

model competitor_review {
  id            String             @id @default(uuid())
  competitor_id String
  reviewer_name String?
  rating        Float?
  content       String?
  item_rented   String?
  review_date   DateTime?
  scraped_at    DateTime           @default(now())
  competitor    competitor_profile @relation(fields: [competitor_id], references: [id], onDelete: Cascade)

  @@index([competitor_id])
  @@index([scraped_at])
  @@index([review_date])
}

model competitor_insight {
  id              String   @id @default(uuid())
  insight_type    String
  content         String
  recommendations Json?
  data_snapshot   Json?
  created_at      DateTime @default(now())

  @@index([insight_type])
  @@index([created_at])
}

model owner_unavailability {
  id         String    @id @default(uuid())
  start_time DateTime
  end_time   DateTime?
  reason     String?
  all_day    Boolean   @default(false)
  active     Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([start_time, end_time])
  @@index([active])
}

model coupon_code {
  id               String    @id @default(uuid())
  code             String    @unique
  discount_percent Float
  description      String?
  active           Boolean   @default(true)
  account          String?
  max_uses         Int?
  times_used       Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  expires_at       DateTime?

  @@index([code])
  @@index([active])
}

model loyalty_voucher {
  id                String         @id @default(uuid())
  code              String         @unique
  renter_profile_id String         @unique
  rental_id         String
  issued_at         DateTime       @default(now())
  used_at           DateTime?
  used_rental_id    String?
  expired           Boolean        @default(false)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  renter_profile    renter_profile @relation(fields: [renter_profile_id], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([issued_at])
}

model return_processing {
  id             String   @id @default(uuid())
  rental_id      String   @unique
  outcome        String
  blacklisted    Boolean  @default(false)
  flagged        Boolean  @default(false)
  review_left    Boolean  @default(false)
  thank_you_sent Boolean  @default(false)
  thank_you_text String?
  earnings       Float?
  processed_by   String   @default("dashboard")
  processed_at   DateTime @default(now())
  notes          String?

  @@index([rental_id])
}

model item_match_cache {
  id               Int      @id @default(autoincrement())
  input_normalized String   @unique
  matched_item     String?
  confidence       Float
  alternatives     String[] @default([])
  is_marketing     Boolean  @default(false)
  inventory_hash   String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([inventory_hash])
}

model funnel_snapshot {
  id                   String   @id @default(uuid())
  period_start         DateTime
  period_end           DateTime
  account              String?
  total                Int
  inquiry              Int
  interested           Int
  ready_to_book        Int
  booked               Int
  confirmed            Int
  completed            Int
  dead                 Int
  pending              Int
  conversion_rate      Float
  engagement_rate      Float
  booking_rate         Float
  drop_off_rate        Float
  revenue              Float
  rental_count         Int
  ai_boost_rate        Float?
  ai_response_coverage Float?
  created_at           DateTime @default(now())

  @@unique([period_start, account])
  @@index([period_start])
}

model item_earnings_snapshot {
  id                 String    @id @default(uuid())
  period_start       DateTime
  period_end         DateTime
  item_name          String
  account            String?
  revenue            Float
  rental_count       Int
  avg_per_rental     Float
  days_rented        Int
  is_current         Boolean
  first_rental       DateTime?
  last_rental        DateTime?
  cumulative_revenue Float
  cumulative_rentals Int
  created_at         DateTime  @default(now())

  @@unique([period_start, item_name, account])
  @@index([period_start])
  @@index([item_name])
}

model bundle_revenue_snapshot {
  id                 String    @id @default(uuid())
  period_start       DateTime
  period_end         DateTime
  bundle_key         String
  bundle_label       String
  items              String[]
  listing_title      String?
  revenue            Float
  rental_count       Int
  avg_per_rental     Float
  days_rented        Int
  cumulative_revenue Float
  cumulative_rentals Int
  first_rental       DateTime?
  last_rental        DateTime?
  created_at         DateTime  @default(now())

  @@unique([period_start, bundle_key])
  @@index([period_start])
  @@index([bundle_key])
}

model insurance_claim {
  id         String   @id @default(uuid())
  amount     Float
  item       String
  damage     String
  is_new     Boolean  @default(true)
  claim_date DateTime @default(now())
  created_at DateTime @default(now())
  notes      String?

  @@index([is_new])
  @@index([claim_date])
}

model inventory_contention {
  id                   String    @id @default(uuid())
  item_name            String
  date_start           DateTime
  date_end             DateTime
  favored_rental_id    String
  held_rental_ids      String[]
  favored_revenue      Float
  held_revenues        Float[]
  urgency_count        Int       @default(0)
  last_urgency_at      DateTime?
  hold_message_sent_to String[]  @default([])
  status               String    @default("active")
  resolution_reason    String?
  resolved_at          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([status])
  @@index([favored_rental_id])
  @@index([item_name, status])
}

model ebay_price_cache {
  id           String   @id @default(uuid())
  item_name    String   @unique
  search_query String
  sold_prices  Json
  median_price Float?
  avg_price    Float?
  min_price    Float?
  max_price    Float?
  sample_count Int      @default(0)
  scraped_at   DateTime @default(now())

  @@index([scraped_at])
}

model conversation_archive {
  id                  String                 @id @default(uuid())
  rental_id           String
  chat_id             String
  message_count       Int
  renter_name         String?
  items_requested     String[]
  use_cases           String[]
  renter_tone         String?
  pricing_sensitivity String?
  engagement_level    String?
  first_message_at    DateTime?
  last_message_at     DateTime?
  final_outcome       String?
  final_rental_value  Float?
  compressed_summary  String?
  key_decisions       Json?
  archived_at         DateTime               @default(now())
  insights            conversation_insight[]

  @@index([rental_id])
  @@index([chat_id])
  @@index([archived_at])
  @@index([final_outcome])
}

model conversation_insight {
  id               String               @id @default(uuid())
  rental_id        String
  archive_id       String
  insight_type     String
  category         String?
  content          String
  confidence       Float                @default(0.8)
  occurrence_count Int                  @default(1)
  is_actionable    Boolean              @default(false)
  suggested_action String?
  created_at       DateTime             @default(now())
  archive          conversation_archive @relation(fields: [archive_id], references: [id], onDelete: Cascade)

  @@index([rental_id])
  @@index([archive_id])
  @@index([insight_type])
  @@index([is_actionable])
  @@index([created_at])
}

model marketing_listing {
  id                   String    @id @default(uuid())
  title                String
  seo_tag              String?
  items                Json
  accessories          Json?
  account              String
  source               String
  source_competitor    String?
  source_listing_id    String?
  image_status         String    @default("pending")
  product_images       String[]
  composed_image       String?
  image_width          Int?
  image_height         Int?
  price_1day           Float?
  price_3day           Float?
  price_7day           Float?
  estimated_value      Float?
  description          String?
  est_monthly_rev_low  Float?
  est_monthly_rev_high Float?
  estimation_basis     String?
  hygglo_listing_id    String?
  hygglo_url           String?
  uploaded_at          DateTime?
  upload_status        String    @default("draft")
  approved_by          String?
  approved_at          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  hygglo_listing_url   String?

  @@index([account])
  @@index([upload_status])
  @@index([image_status])
}

model winback_campaign {
  id                String    @id @default(uuid())
  renter_profile_id String    @unique
  rental_id         String
  listing_id        String
  account           String
  coupon_code       String
  sent_at           DateTime?
  campaign_month    DateTime
  created_at        DateTime  @default(now())

  @@index([campaign_month])
  @@index([coupon_code])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ground_truth {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_name        String
  fact_type        String
  verified_value   String
  numeric_value    Decimal?  @db.Decimal
  source           String
  source_detail    String?
  last_verified_at DateTime? @default(now()) @db.Timestamp(6)
  confidence       Int?      @default(5)
  needs_review     Boolean?  @default(false)
  notes            String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([item_name], map: "idx_ground_truth_item")
  @@index([fact_type], map: "idx_ground_truth_type")
}
