// Prisma schema for Rental Manager

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model rental {
  id              String          @id @default(uuid())
  listing_id      String          @unique
  title           String
  status          String          // 'ongoing' or 'upcoming'
  start_date      DateTime?
  end_date        DateTime?
  renter_info     String?
  listing_url     String
  description     String?         @db.Text
  photos_urls     String[]        // Array of photo URLs
  rental_price    Float?          // owner earnings (what Daniel receives after platform fees)
  renter_price    Float?          // renter-facing total (what borrower pays including platform fees)
  price_per_day   Float?          // calculated owner earnings per day
  currency        String?         @default("GBP")
  account         String?         // 'dbcinema' or 'leo' — which Hygglo account this rental belongs to
  listing_location String?        // Advertised pickup location from the listing (e.g. "Stratford", "Shoreditch") — may be fake
  parsed_items    Json?           // AI-parsed items: [{item: "Sony FX3", qty: 1}, {item: "Sony GM 24-70mm f2.8", qty: 1}]
  order_step      String?         // Active Hygglo order step: REQUEST, APPROVED, FUNDS_RESERVED, VERIFIED, BOOKED_AFTER_VERIFIED, DELIVERED, RETURNED, REVIEWED
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  extracted_items extracteditem[]
  catalog_items   itemcatalog[]
  ai_decisions    ai_decision[]
  bookings        booking[]
  follow_up_state follow_up_state?
  renter_links    rental_renter_link[]

  @@index([status])
  @@index([listing_id])
  @@index([account])
}

model extracteditem {
  id               String   @id @default(uuid())
  rental_id        String
  item_name        String
  source           String   // 'photo' or 'description'
  confidence_score Float?
  created_at       DateTime @default(now())
  rental           rental   @relation(fields: [rental_id], references: [id], onDelete: Cascade)

  @@index([rental_id])
  @@index([source])
}

model itemcatalog {
  id             String   @id @default(uuid())
  listing_id     String
  item_name      String
  description    String?  @db.Text
  first_seen_at  DateTime @default(now())
  rental         rental   @relation(fields: [listing_id], references: [listing_id], onDelete: Cascade)

  @@unique([listing_id, item_name])
  @@index([listing_id])
}

model conversation {
  id         String   @id @default(uuid())
  chat_id    String
  role       String   // 'user', 'assistant', 'system'
  content    String   @db.Text
  metadata   Json?
  created_at DateTime @default(now())

  @@index([chat_id])
  @@index([created_at])
  @@index([chat_id, created_at])
}

model ai_decision {
  id                String   @id @default(uuid())
  rental_id         String?
  decision_type     String   // 'approve', 'reject', 'message', 'escalate', 'analyze'
  input_summary     String   @db.Text
  output_summary    String   @db.Text
  confidence        Float?
  action_taken      String?  @db.Text
  notified          Boolean  @default(false)
  was_sent          Boolean? // true = sent, false = blocked, null = legacy/internal
  feedback_analyzed Boolean  @default(false) // has the feedback loop processed this row?
  created_at        DateTime @default(now())
  rental            rental?  @relation(fields: [rental_id], references: [id], onDelete: SetNull)

  @@index([rental_id])
  @@index([decision_type])
  @@index([created_at])
  @@index([created_at, confidence])
  @@index([was_sent])
  @@index([feedback_analyzed])
}

model rule {
  id         String   @id @default(uuid())
  category   String   // 'inventory', 'policy', 'communication', 'pricing', 'faq'
  name       String
  content    String   @db.Text
  is_active  Boolean  @default(true)
  priority   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([category])
  @@index([is_active])
}

model memory {
  id           String    @id @default(uuid())
  memory_type  String    // 'pattern', 'fact', 'preference', 'renter_profile'
  subject      String
  content      String    @db.Text
  importance   Int       @default(5) // 1-10
  access_count Int       @default(0)
  expires_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([memory_type])
  @@index([importance])
  @@index([subject])
}

model bot_config {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text

  @@index([key])
}

// === Phase 1A: Availability Calendar ===

model booking {
  id              String    @id @default(uuid())
  item_name       String
  quantity        Int       @default(1)
  start_date      DateTime
  end_date        DateTime
  renter_name     String
  renter_contact  String?
  account         String    // 'dbcinema' or 'leo'
  rental_id       String?
  rental          rental?   @relation(fields: [rental_id], references: [id], onDelete: SetNull)
  pickup_time     String?   // e.g. '10:00'
  return_time     String?   // e.g. '19:00'
  pickup_date     DateTime? // Actual pickup date (may be evening before start_date)
  return_date     DateTime? // Actual return date (may be morning after end_date)
  pickup_reminded Boolean   @default(false)
  return_reminded Boolean   @default(false)
  // Arrival confirmation tracking
  pickup_arrival_sent_at        DateTime?  // When first pickup arrival check was sent to renter
  pickup_arrival_followup_sent  Boolean    @default(false) // Second arrival reminder sent
  pickup_arrival_confirmed      Boolean    @default(false) // Renter confirmed pickup arrival
  return_arrival_sent_at        DateTime?  // When first return arrival check was sent to renter
  return_arrival_followup_sent  Boolean    @default(false) // Second return arrival reminder sent
  return_arrival_confirmed      Boolean    @default(false) // Renter confirmed return arrival
  // Delivery method tracking (null = unknown/not discussed, 'collection' = in-person, 'delivery' = Addison Lee courier)
  pickup_method   String?   // 'collection' or 'delivery' — only set when CONFIRMED, not just discussed
  return_method   String?   // 'collection' or 'delivery' — only set when CONFIRMED, not just discussed
  status          String    @default("confirmed") // 'confirmed', 'completed', 'cancelled'
  revenue         Float?
  platform_fee    Float?
  delivery_fee    Float?
  net_profit      Float?
  notes           String?   @db.Text
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([item_name])
  @@index([start_date, end_date])
  @@index([renter_name])
  @@index([status])
  @@index([account])
  @@index([item_name, status, start_date, end_date])
}

// === Phase 1B: Renter Blacklist ===

model blacklisted_renter {
  id         String   @id @default(uuid())
  name       String   @unique
  reason     String   @db.Text
  added_by   String   @default("owner")
  created_at DateTime @default(now())
}

// === Phase 2A: Demand Tracker ===

model demand_record {
  id               String    @id @default(uuid())
  items            String[]
  bundle_label     String?
  dates_start      DateTime?
  dates_end        DateTime?
  renter_name      String?
  account          String?
  outcome          String    @default("pending") // 'accepted', 'rejected', 'pending', 'cancelled'
  rejection_reason String?
  rental_value     Float?
  source           String?   // 'hygglo', 'manual', etc.
  created_at       DateTime  @default(now())

  @@index([outcome])
  @@index([created_at])
}

// === Phase 4A: Delivery Quote Calculator ===

model item_spec {
  id         String  @id @default(uuid())
  item_name  String  @unique
  weight_kg  Float?
  length_cm  Float?
  width_cm   Float?
  height_cm  Float?
  size_score Int     @default(2) // 1-5: XS/S/M/L/XL
  category   String?
  notes      String?

  @@index([item_name])
  @@index([size_score])
}

// === Phase 4B: Market Insight Tool ===

model market_snapshot {
  id           String   @id @default(uuid())
  competitor   String
  item_name    String
  price_daily  Float?
  review_count Int?
  avg_rating   Float?
  listing_url  String?
  scraped_at   DateTime @default(now())

  @@index([competitor])
  @@index([item_name])
  @@index([scraped_at])
}

model market_report {
  id          String   @id @default(uuid())
  report_type String   // 'weekly', 'on_demand'
  content     String   @db.Text
  insights    Json?
  created_at  DateTime @default(now())

  @@index([report_type])
  @@index([created_at])
}

// === Error Log (local monitoring, replaces external Sentry) ===

model error_log {
  id                String   @id @default(uuid())
  error_type        String   // 'exception', 'quality_warning', 'validation_failure', 'slow_api'
  operation         String   // 'telegram_polling', 'vision_analysis', etc.
  message           String   @db.Text
  stack_trace       String?  @db.Text
  context           Json?
  feedback_analyzed Boolean  @default(false)
  created_at        DateTime @default(now())

  @@index([feedback_analyzed])
  @@index([created_at])
}

// === Intelligence & Safety Improvements ===

model validation_log {
  id             String   @id @default(uuid())
  ai_decision_id String?
  response_text  String   @db.Text
  violations     String[]
  severity       String   // 'critical', 'high', 'medium', 'low'
  blocked        Boolean
  created_at     DateTime @default(now())

  @@index([severity])
  @@index([blocked])
  @@index([created_at])
  @@index([ai_decision_id])
}

model response_quality {
  id                  String   @id @default(uuid())
  ai_decision_id      String   @unique
  pricing_accuracy    Float?
  rule_compliance     Float
  conciseness         Float
  tone_match          Float
  overall_quality     Float
  computed_confidence Float
  created_at          DateTime @default(now())

  @@index([overall_quality])
  @@index([created_at])
}

model prompt_component {
  id           String   @id @default(uuid())
  name         String
  version      String
  content      String   @db.Text
  category     String   // 'core', 'rules', 'context', 'instructions'
  active       Boolean  @default(true)
  ab_group     String?  // 'A', 'B', null
  usage_count  Int      @default(0)
  pass_rate    Float?   // validation pass rate
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([name, version])
  @@index([category])
  @@index([active])
  @@index([ab_group])
}

model prompt_version_log {
  id              String   @id @default(uuid())
  component_name  String
  version         String
  ai_decision_id  String
  validation_pass Boolean
  quality_score   Float?
  created_at      DateTime @default(now())

  @@index([component_name])
  @@index([version])
  @@index([created_at])
}

// === Rental Acceptance Rules ===

model renter_profile {
  id                        String               @id @default(uuid())
  hygglo_user_id            String?              @unique
  name                      String
  name_variants             String[]
  verification_status       String               @default("unknown") // 'unknown', 'pending', 'verified', 'failed'
  verification_attempts     Int                  @default(0)
  verification_guided       Boolean              @default(false)
  verification_failure_guided Boolean            @default(false)
  total_rentals             Int                  @default(0)
  total_spend               Float                @default(0)
  items_interested          String[]             // Items this renter has asked about or booked
  rental_progress           String?              @db.Text // Current request progress summary (e.g. "agreed on FX3+24-70, dates 5-7 Feb, pickup 10am")
  previous_agreements       String?              @db.Text // What was agreed in prior rentals/cancelled requests — for re-request context
  last_inquiry_summary      String?              @db.Text // What they last asked about
  first_seen_at             DateTime             @default(now())
  last_seen_at              DateTime             @default(now())
  renter_links              rental_renter_link[]

  requires_manual_approval  Boolean   @default(false)
  rental_issues_note        String?   @db.Text

  hygglo_rating             Float?    // Average star rating (1-5), null = unknown
  hygglo_review_count       Int?      // Number of reviews
  hygglo_bad_reviews        String?   @db.Text  // JSON array of reviews < 5 stars: [{stars, text, date}]
  rating_checked_at         DateTime? // When rating was last checked

  loyalty_voucher           loyalty_voucher?

  @@index([name])
  @@index([hygglo_user_id])
}

model rental_renter_link {
  id                String         @id @default(uuid())
  rental_id         String
  renter_profile_id String
  created_at        DateTime       @default(now())
  rental            rental         @relation(fields: [rental_id], references: [id], onDelete: Cascade)
  renter_profile    renter_profile @relation(fields: [renter_profile_id], references: [id], onDelete: Cascade)

  @@unique([rental_id, renter_profile_id])
  @@index([rental_id])
  @@index([renter_profile_id])
}

// === Postcode Cache ===

model postcode_cache {
  id          String   @id @default(uuid())
  postcode    String   @unique
  latitude    Float
  longitude   Float
  distance_km Float
  zone        String
  cached_at   DateTime @default(now())

  @@index([postcode])
  @@index([cached_at])
}

// === Upsell Tracking ===

model upsell_log {
  id                String   @id @default(uuid())
  rental_id         String
  items_suggested   String[]
  items_accepted    String[]
  revenue_before    Float
  revenue_after     Float?
  upsell_priority   String   // 'critical', 'high', 'medium', 'low'
  use_case_detected String?
  outcome           String   @default("pending") // 'pending', 'accepted', 'partial', 'rejected', 'ignored'
  created_at        DateTime @default(now())

  @@index([rental_id])
  @@index([outcome])
  @@index([created_at])
}

// === Revenue Tracking ===

model revenue_metric {
  id              String   @id @default(uuid())
  rental_id       String?
  metric_type     String   // 'booking_revenue', 'upsell_revenue', 'discount_applied', 'delivery_fee', 'platform_fee'
  amount          Float
  account         String?  // 'dbcinema' or 'leo'
  metadata        Json?
  period_start    DateTime?
  period_end      DateTime?
  created_at      DateTime @default(now())

  @@index([metric_type])
  @@index([account])
  @@index([created_at])
  @@index([rental_id])
}

// === AutoLearn Engine ===

model autolearn_proposal {
  id              String    @id @default(uuid())
  cycle_id        String
  analyzer        String    // 'violation'|'quality'|'conversion'|'token'|'correction'
  change_type     String    // 'rule_add'|'rule_edit'|'rule_deactivate'|'prompt_edit'|'threshold_adjust'
  target_entity   String    // e.g. 'rule:pricing:Bundle_Rec' or 'prompt:communication_style'
  description     String    @db.Text
  change_payload  Json      // { before, after, metadata }
  shadow_result   Json?     // { replayed, improved, degraded, neutral, avgQualityDelta }
  status          String    @default("pending") // pending|approved|vetoed|applied|rolled_back|expired|rework|failed
  veto_deadline   DateTime
  vetoed_by       String?
  veto_reason     String?
  applied_at      DateTime?
  rolled_back_at  DateTime?
  rework_count    Int       @default(0)
  parent_id       String?
  rework_reason   String?   @db.Text
  failed_shadow   Json?
  created_at      DateTime  @default(now())

  @@index([status])
  @@index([veto_deadline])
  @@index([cycle_id])
  @@index([analyzer])
  @@index([created_at])
}

model autolearn_log {
  id              String    @id @default(uuid())
  proposal_id     String?
  event_type      String    // cycle_start|cycle_end|applied|vetoed|rollback|daily_summary
  details         Json?
  quality_before  Float?
  quality_after   Float?
  created_at      DateTime  @default(now())

  @@index([event_type])
  @@index([proposal_id])
  @@index([created_at])
}

model autolearn_snapshot {
  id              String    @id @default(uuid())
  proposal_id     String
  entity_type     String    // 'rule'|'prompt_component'|'bot_config'
  entity_id       String
  snapshot_data   Json
  created_at      DateTime  @default(now())

  @@index([proposal_id])
  @@index([entity_type])
  @@index([created_at])
}

model follow_up_state {
  id                    String    @id @default(uuid())
  rental_id             String    @unique
  rental                rental    @relation(fields: [rental_id], references: [id], onDelete: Cascade)
  last_renter_message_at DateTime?
  last_bot_message_at   DateTime?
  last_bot_followup_at  DateTime?
  followup_count        Int       @default(0)
  custom_reminder_at    DateTime?
  custom_reminder_reason String?
  paused_until          DateTime?
  auto_accept_eligible  Boolean   @default(false)
  auto_accepted         Boolean   @default(false)
  items_confirmed       Boolean   @default(false)
  availability_verified Boolean   @default(false)
  discount_eligible     Boolean   @default(false)
  discount_applied      Boolean   @default(false)
  conversation_stage    String    @default("inquiry") // inquiry, interested, ready_to_book, booked, confirmed, completed, dead
  stage_before_dead     String?   // stores previous stage when conversation goes DEAD, for smart revival
  stage_changed_at      DateTime?
  time_request_sent        Boolean   @default(false)
  time_request_sent_at     DateTime?
  time_followup_count      Int       @default(0)
  last_time_followup_at    DateTime?
  times_status             String    @default("none")  // none|tentative|confirmed|auto_assigned
  times_auto_assigned      Boolean   @default(false)
  times_auto_assigned_at   DateTime?
  conversation_summary     String?   @db.Text
  rejected_suggestions     String?   // comma-separated list of items the renter declined
  structured_state         Json?     // { confirmedItems, agreedTimes, questionsAsked, etc. }
  status                String    @default("active") // 'active', 'completed', 'paused', 'auto_accepted'
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([status])
  @@index([rental_id])
}

// === Lost Revenue Tracking ===

model lost_revenue_record {
  id              String   @id @default(uuid())
  hygglo_order_id String   @unique
  title           String
  renter_info     String?
  account         String
  start_date      DateTime
  end_date        DateTime
  rental_days     Int
  hygglo_price    Float?
  estimated_price Float?
  lost_revenue    Float
  items_requested Json
  stock_blocked   Boolean
  blocked_items   String[]
  unmatched_items String[]
  denial_type     String?   // 'owner_denied' | 'unavailable' | 'verification_failed' | 'unmatched'
  active_step     String?   // Hygglo step where active=true when rental went obsolete
  synced_at       DateTime @default(now())
  created_at      DateTime @default(now())

  @@index([account])
  @@index([start_date])
  @@index([stock_blocked])
  @@index([denial_type])
}

model revenue_loss_monthly {
  id                    String   @id @default(uuid())
  period_start          DateTime
  period_end            DateTime
  account               String   @default("")  // empty string = global aggregate
  denied_revenue        Float
  denied_count          Int
  denied_items          String[]
  lost_revenue          Float
  lost_count            Int
  lost_items            String[]
  created_at            DateTime @default(now())
  @@unique([period_start, account])
  @@index([period_start])
}

// === Competitor Intelligence (dashboard-only, separate from rental bot) ===

model competitor_profile {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  profile_url    String?
  total_reviews  Int      @default(0)
  avg_rating     Float?
  total_listings Int      @default(0)
  last_scraped   DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  listings       competitor_listing[]
  reviews        competitor_review[]

  @@index([name])
}

model competitor_listing {
  id              String   @id @default(uuid())
  competitor_id   String
  competitor      competitor_profile @relation(fields: [competitor_id], references: [id], onDelete: Cascade)
  title           String
  item_category   String?
  daily_price     Float?
  owner_earnings  Float?
  listing_url     String?
  listing_slug    String?
  is_active       Boolean  @default(true)
  first_seen      DateTime @default(now())
  last_seen       DateTime @default(now())

  @@unique([competitor_id, title])
  @@index([competitor_id])
  @@index([item_category])
  @@index([is_active])
}

model competitor_review {
  id              String   @id @default(uuid())
  competitor_id   String
  competitor      competitor_profile @relation(fields: [competitor_id], references: [id], onDelete: Cascade)
  reviewer_name   String?
  rating          Float?
  content         String?  @db.Text
  item_rented     String?
  review_date     DateTime?
  scraped_at      DateTime @default(now())

  @@index([competitor_id])
  @@index([scraped_at])
  @@index([review_date])
}

model competitor_insight {
  id              String   @id @default(uuid())
  insight_type    String
  content         String   @db.Text
  recommendations Json?
  data_snapshot   Json?
  created_at      DateTime @default(now())

  @@index([insight_type])
  @@index([created_at])
}

// === Owner Unavailability / Vacation Blocks ===

model owner_unavailability {
  id         String    @id @default(uuid())
  start_time DateTime           // full datetime — supports "Saturday from 10:30"
  end_time   DateTime?          // null = rest of day / open-ended
  reason     String?            // "vacation", "personal", etc.
  all_day    Boolean   @default(false)
  active     Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([start_time, end_time])
  @@index([active])
}

// === Coupon Codes ===

model coupon_code {
  id                String    @id @default(uuid())
  code              String    @unique
  discount_percent  Float
  description       String?
  active            Boolean   @default(true)
  account           String?   // null = all accounts
  max_uses          Int?
  times_used        Int       @default(0)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([code])
  @@index([active])
}

model loyalty_voucher {
  id                String          @id @default(uuid())
  code              String          @unique
  renter_profile_id String          @unique  // One active voucher per renter (newest replaces old)
  rental_id         String          // Rental that earned this voucher
  issued_at         DateTime        @default(now())
  used_at           DateTime?
  used_rental_id    String?
  expired           Boolean         @default(false)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  renter_profile    renter_profile  @relation(fields: [renter_profile_id], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([issued_at])
}

// === Return Processing ===

model return_processing {
  id              String    @id @default(uuid())
  rental_id       String    @unique
  outcome         String    // 'good' | 'issues'
  blacklisted     Boolean   @default(false)
  flagged         Boolean   @default(false)
  review_left     Boolean   @default(false)
  thank_you_sent  Boolean   @default(false)
  thank_you_text  String?   @db.Text
  earnings        Float?
  processed_by    String    @default("dashboard")
  processed_at    DateTime  @default(now())
  notes           String?   @db.Text

  @@index([rental_id])
}

// === AI Item Matcher Cache ===

model item_match_cache {
  id               Int      @id @default(autoincrement())
  input_normalized String   @unique
  matched_item     String?
  confidence       Float
  alternatives     String[] @default([])
  is_marketing     Boolean  @default(false)
  inventory_hash   String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([inventory_hash])
}

// === Monthly Funnel Snapshot Log ===

model funnel_snapshot {
  id               String   @id @default(uuid())
  period_start     DateTime // 1st of month
  period_end       DateTime // 1st of next month
  account          String?  // null = all accounts, 'dbcinema', 'leo'

  // Stage counts
  total            Int
  inquiry          Int
  interested       Int
  ready_to_book    Int
  booked           Int
  confirmed        Int
  completed        Int
  dead             Int
  pending          Int      // verification pending

  // Derived rates
  conversion_rate  Float    // (confirmed + completed) / total
  engagement_rate  Float    // (total - inquiry) / total
  booking_rate     Float    // (booked+pending+confirmed+completed) / engaged
  drop_off_rate    Float    // dead / total

  // Revenue context
  revenue          Float    // owner earnings for this period
  rental_count     Int      // distinct rental visits

  // AI context (from latest weekly evaluation at time of snapshot)
  ai_boost_rate    Float?
  ai_response_coverage Float?

  created_at       DateTime @default(now())

  @@unique([period_start, account])
  @@index([period_start])
}

// === Per-Item Monthly Earnings Snapshot ===

model item_earnings_snapshot {
  id              String   @id @default(uuid())
  period_start    DateTime // 1st of month
  period_end      DateTime // 1st of next month
  item_name       String   // clean MASTER_INVENTORY name or retired item name
  account         String?  // null = all accounts, 'dbcinema', 'leo'

  revenue         Float    // owner earnings for this item in this period
  rental_count    Int      // number of completed bookings
  avg_per_rental  Float    // average revenue per rental
  days_rented     Int      // total rental days in this period

  // Lifecycle context
  is_current      Boolean  // true = in current MASTER_INVENTORY, false = retired/sold
  first_rental    DateTime? // earliest booking start_date ever
  last_rental     DateTime? // most recent booking end_date

  // Cumulative (all-time up to this period)
  cumulative_revenue    Float
  cumulative_rentals    Int

  created_at      DateTime @default(now())

  @@unique([period_start, item_name, account])
  @@index([period_start])
  @@index([item_name])
}

// === Bundle/Set Monthly Revenue Snapshot ===

model bundle_revenue_snapshot {
  id              String   @id @default(uuid())
  period_start    DateTime // 1st of month
  period_end      DateTime // 1st of next month

  bundle_key      String   // sorted item names joined with ' + '
  bundle_label    String   // human-readable label (e.g. "Sony FX3 + 24-70mm GM Kit")
  items           String[] // individual item names in the bundle
  listing_title   String?  // representative Hygglo listing title

  revenue         Float    // total owner earnings for this bundle combo in this period
  rental_count    Int      // number of completed rentals
  avg_per_rental  Float    // average revenue per rental
  days_rented     Int      // total rental days

  // Cumulative
  cumulative_revenue  Float
  cumulative_rentals  Int
  first_rental        DateTime?
  last_rental         DateTime?

  created_at      DateTime @default(now())

  @@unique([period_start, bundle_key])
  @@index([period_start])
  @@index([bundle_key])
}

// === Insurance Claims ===

model insurance_claim {
  id          String   @id @default(uuid())
  amount      Float                        // payout amount in GBP
  item        String                        // what item was damaged
  damage      String   @db.Text            // damage description
  notes       String?  @db.Text            // optional extra notes
  is_new      Boolean  @default(true)      // new=count in revenue, old=log only
  claim_date  DateTime @default(now())     // when the claim was made
  created_at  DateTime @default(now())
  @@index([is_new])
  @@index([claim_date])
}

// === Inventory Contention (Yield-Optimized Conflict Resolution) ===

model inventory_contention {
  id                     String    @id @default(uuid())

  // Scarce resource
  item_name              String    // MASTER_INVENTORY canonical name
  date_start             DateTime  // Overlap window start
  date_end               DateTime  // Overlap window end

  // Competing rentals
  favored_rental_id      String    // Highest revenue (PUSHED with urgency)
  held_rental_ids        String[]  // Lower revenue (HELD, paused)

  // Revenue snapshot (immutable at detection time)
  favored_revenue        Float     // rental_price of favored
  held_revenues          Float[]   // rental_price of each held (parallel to held_rental_ids)

  // Urgency tracking for favored rental
  urgency_count          Int       @default(0)
  last_urgency_at        DateTime?

  // Hold tracking for held rentals
  hold_message_sent_to   String[]  @default([]) // rental IDs that got the one-time hold message

  // Lifecycle
  status                 String    @default("active") // active | resolved_booked | resolved_timeout | resolved_cancelled
  resolution_reason      String?
  resolved_at            DateTime?

  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@index([status])
  @@index([favored_rental_id])
  @@index([item_name, status])
}

// === eBay Price Cache (Sell Recommender) ===

model ebay_price_cache {
  id            String   @id @default(uuid())
  item_name     String   @unique
  search_query  String
  sold_prices   Json     // number[] of recent sold prices (GBP)
  median_price  Float?
  avg_price     Float?
  min_price     Float?
  max_price     Float?
  sample_count  Int      @default(0)
  scraped_at    DateTime @default(now())

  @@index([scraped_at])
}
