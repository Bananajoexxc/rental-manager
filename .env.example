# Hygglo Account Credentials
HYGGLO_EMAIL=your_email@example.com
HYGGLO_PASSWORD=your_password

# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/rental_manager

# Abacus AI API Key (for image analysis)
ABACUSAI_API_KEY=your_api_key_here

# Scanning Configuration
INITIAL_SCAN_INTERVAL_MS=60000  # 1 minute
REDUCED_SCAN_INTERVAL_MS=300000  # 5 minutes
INACTIVITY_THRESHOLD_MS=1800000  # 30 minutes

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Logging
LOG_LEVEL=info

# Anthropic AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20250514
CLAUDE_MODEL_COMPLEX=claude-sonnet-4-20250514

# Bot Owner
OWNER_CHAT_ID=6634478551

# Read-Only Mode (prevents bot from sending messages to renters)
READ_ONLY_MODE=true

# Modular Prompts
USE_MODULAR_PROMPTS=true

# Sentry Error Monitoring
# Get DSN from: https://sentry.io/settings/projects/your-project/keys/
SENTRY_DSN=

# DSPy Prompt Optimization
DSPY_PORT=5000
DSPY_ENABLED=true

# Google Vision API
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
